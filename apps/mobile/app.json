{
  "expo": {
    "name": "Groundwork",
    "slug": "groundwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "groundwork",
    "userInterfaceStyle": "automatic",
    "description": "Find co-founders and startup builders, and validate ideas with Think.",
    "android": {
      "package": "com.groundwork.network",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "groundwork" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.groundwork.network",
      "supportsTablet": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#111111", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      ["expo-build-properties", { "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "minSdkVersion": 24 } }],
      ["expo-notifications", { "color": "#0F6E4F", "defaultChannel": "default" }],
      ["expo-image-picker", { "photosPermission": "Allow Groundwork to use a photo you choose as your profile picture.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "experiments": { "typedRoutes": false, "reactCompiler": true },
    "extra": {
      "supabaseUrl": "",
      "supabasePublishableKey": "",
      "siteUrl": "",
      "eas": { "projectId": "" }
    }
  }
}
